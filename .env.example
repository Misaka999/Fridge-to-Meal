DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Render full-catalogue deployment defaults to data/ inside the build artifact.
# No persistent disk or /var/data paths are required. See docs/RENDER_DEPLOY.md.
# Optional overrides for a different, explicitly pinned dataset version:
# FRIDGE_RECIPE_DOWNLOAD_URL=https://example.com/RecipeNLG_dataset.csv
# FRIDGE_RECIPE_SHA256=<sha256 of that CSV>
# FRIDGE_RECIPE_BYTES=<CSV size in bytes>
# FRIDGE_RECIPE_RECORDS=<indexed Gathered record count>
